# Copy to .env and fill in. Never commit .env.

# --- required: LLM provider (free tier at https://console.groq.com) ---
GROQ_API_KEY=

# --- optional: model overrides ---
TOOL_MODEL=llama-3.3-70b-versatile
SYNTH_MODEL=llama-3.3-70b-versatile
CRITIC_MODEL=llama-3.3-70b-versatile

# --- optional: observability (free tier at https://cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- optional: live web search (https://tavily.com). Agent runs without it. ---
TAVILY_API_KEY=

# --- guardrails ---
MAX_USD=2.0
WARN_USD=0.5
MAX_STEPS=6
SELF_CONSISTENCY_K=3
